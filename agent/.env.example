# CookMate voice agent environment
# Copy to .env and fill in real values:  cd agent && cp .env.example .env
#
# These are SERVER-side secrets. They stay in agent/ and are never bundled
# into the mobile app — do not copy them into the root .env.
#
# dotenv resolves this file from the working directory, so run the agent
# from agent/ (npm run dev | npm run start | npm run token).

# --- LiveKit (agent/src/agent.ts, agent/src/generate-token.ts) ---
# From the LiveKit Cloud dashboard -> Settings -> Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# STT (deepgram/nova-3), LLM (google/gemini-2.5-flash), TTS (cartesia/sonic-3)
# and VAD all run through LiveKit Inference, so they are billed against the
# keys above and need no separate provider keys.
