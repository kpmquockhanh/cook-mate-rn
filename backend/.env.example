# ---- Database (Supabase Postgres, direct connection) --------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION pooler (port 5432) or direct connection; the transaction pooler
# (6543) does not support the prepared statements / advisory locks used here.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ---- Anthropic (stage 3: enrichment) ------------------------------------------
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Bulk extractor tier. Cheap + deterministic enough for a tight schema.
ENRICH_MODEL=claude-haiku-4-5
# Escalation tier, used to retry recipes the quality gate rejects.
ENRICH_ESCALATION_MODEL=claude-opus-5
# Bump this when you change the enrichment prompt/schema so old rows re-enrich.
ENRICHMENT_VERSION=1

# ---- Crawl politeness ---------------------------------------------------------
CRAWL_USER_AGENT=CookMateBot/1.0 (+https://cookmate.app/bot; contact@cookmate.app)
CRAWL_CONCURRENCY=4
CRAWL_DEFAULT_DELAY_MS=2000
CRAWL_TIMEOUT_MS=20000

# ---- Quality gate -------------------------------------------------------------
QUALITY_MIN_SCORE=70

# ---- API auth (src/api/auth.ts) ------------------------------------------------
# Every route except /health requires a Supabase access token:
#   Authorization: Bearer <session.access_token>
#
# Project URL. Supplies the JWKS endpoint for asymmetric (ES256/RS256) signing
# keys and the expected `iss`. This is all a current Supabase project needs.
SUPABASE_URL=https://PROJECT.supabase.co
# Only for a project still signing with the legacy HS256 secret:
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret.
# NOT the publishable key and NOT the service-role key.
SUPABASE_JWT_SECRET=

# ---- API server ----------------------------------------------------------------
# API_PORT=8787
# API_HOST=0.0.0.0
# Lock this to the web build's origin in production; '*' is a dev default.
# API_CORS_ORIGIN=*

# ---- Pipeline console ----------------------------------------------------------
# `npm run ui` serves the operator console (discover, enqueue, run stages,
# review queue) on this port, protected by HTTP Basic Auth - it can start
# crawls and spend model budget, so REVIEW_USERNAME/REVIEW_PASSWORD are
# required and the server refuses to start without them.
REVIEW_PORT=5174
REVIEW_USERNAME=admin
REVIEW_PASSWORD=change-me
# 127.0.0.1 by default. The Docker image sets this to 0.0.0.0 so the console
# is reachable through its published port - do that only with real credentials
# above, never with the placeholder ones.
# REVIEW_HOST=127.0.0.1
