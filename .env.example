# CookMate — Expo app environment
# Copy to .env and fill in real values:  cp .env.example .env
#
# WARNING: every EXPO_PUBLIC_* value is inlined into the JS bundle at build
# time and is readable by anyone with the app. Never put a service-role key,
# API secret, or anything else private here.

# --- Supabase (lib/supabase.ts) ---
# Project URL and the PUBLISHABLE key (sb_publishable_...) only.
# Never the secret key (sb_secret_...) - see the warning above.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- REST API (hooks/useRecipe.ts, hooks/useRecipes.ts) ---
# Base URL of the recipes API, no trailing slash.
EXPO_PUBLIC_API_URL=https://api.example.com

# --- Media storage (utils/index.ts) ---
# Base URL used to resolve recipe image paths, no trailing slash.
EXPO_PUBLIC_STORAGE_URL=https://storage.example.com

# --- LiveKit voice assistant (app/cooking/[id].tsx) ---
# Your LiveKit Cloud / self-hosted websocket URL.
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# Dev-only shortcut: a pre-minted room token from `cd agent && npm run token`.
# In production, mint tokens server-side per user instead of shipping one.
